{
	"$type": "com.atproto.lexicon.schema",
	"lexicon": 1,
	"id": "dev.cartridge.migrateClaim",
	"defs": {
		"main": {
			"type": "procedure",
			"description": "Enqueue migration of game records based on an approved claim.",
			"input": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["claim", "claimReview"],
					"properties": {
						"claim": {
							"type": "string",
							"format": "at-uri"
						},
						"claimReview": {
							"type": "string",
							"format": "at-uri"
						}
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"type": "object",
					"required": ["jobId", "status", "gamesCount"],
					"properties": {
						"jobId": {
							"type": "string",
							"maxLength": 128
						},
						"status": {
							"type": "string",
							"maxLength": 64
						},
						"gamesCount": {
							"type": "integer"
						}
					}
				}
			}
		}
	}
}
