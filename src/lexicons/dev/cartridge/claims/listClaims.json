{
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "id": "dev.cartridge.claims.listClaims",
  "defs": {
    "main": {
      "type": "query",
      "description": "List ownership claims, optionally filtered by status.",
      "parameters": {
        "type": "params",
        "properties": {
          "status": {
            "type": "string",
            "maxLength": 64,
            "knownValues": ["pending", "approved", "denied"]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          },
          "cursor": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["claims"],
          "properties": {
            "claims": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "dev.cartridge.claims.getClaim#claimView"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}